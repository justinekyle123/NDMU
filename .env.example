# Choose the database target used by the app and Drizzle Kit.
# Allowed values: local or neon
DATABASE_TARGET=local

# Local PostgreSQL connection.
LOCAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ndmu

# Neon cloud PostgreSQL connection.
# Set DATABASE_TARGET=neon and replace this placeholder with the pooled
# connection string from the Neon dashboard.
# NEON_DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require
